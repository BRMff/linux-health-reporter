{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
